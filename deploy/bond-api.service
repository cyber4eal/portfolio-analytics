# Transaction API for the Bond Portfolio Centre.
#
# Runs as a plain systemd service on the VPS. It reaches the Google Sheet
# through the portfolio-agent checkout's service account, so AGENT_DIR must
# point at that checkout - without it the API still records trades in the
# ledger and simply does not mirror them.
#
#   cp deploy/bond-api.service /etc/systemd/system/
#   systemctl daemon-reload && systemctl enable --now bond-api

[Unit]
Description=Bond Portfolio Centre transaction API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/portfolio-analytics
# A rebuild started from the site has to land where nginx serves,
# not in the checkout - otherwise it reports success and the page
# stays stale, which is worse than failing.
Environment=BOND_SITE_DIR=/var/www/fundlab
Environment=AGENT_DIR=/root/portfolio-agent
ExecStart=/usr/bin/python3 /opt/portfolio-analytics/server/api.py --port 8001 --host 127.0.0.1
Restart=on-failure
RestartSec=5

# It writes its own data directory, the Google Sheet, and - when a
# rebuild is started from the site - the served payload.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/portfolio-analytics/data /var/www/fundlab

[Install]
WantedBy=multi-user.target
